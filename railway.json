{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm --prefix app_src install && npm run build",
    "watchPatterns": [
      "/app_src/**",
      "/scripts/**",
      "/db/**",
      "/docs/**",
      "/package.json",
      "/railway.json"
    ]
  },
  "deploy": {
    "startCommand": "npm run start:railway",
    "preDeployCommand": "npm run mail:verify && npm run db:migrate",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
