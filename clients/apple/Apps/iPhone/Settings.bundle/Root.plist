<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>PreferenceSpecifiers</key>
    <array>
        <dict>
            <key>Type</key>
            <string>PSGroupSpecifier</string>
            <key>Title</key>
            <string>Picking audio</string>
            <key>FooterText</key>
            <string>Automatic uses connected Bluetooth audio, including Meta glasses, and otherwise uses the iPhone loudspeaker. iOS controls the final accessory route.</string>
        </dict>
        <dict>
            <key>Type</key>
            <string>PSMultiValueSpecifier</string>
            <key>Title</key>
            <string>Instruction playback</string>
            <key>Key</key>
            <string>clawpilot_audio_playback</string>
            <key>DefaultValue</key>
            <string>automatic</string>
            <key>Titles</key>
            <array>
                <string>Automatic — Meta glasses when connected</string>
                <string>Always iPhone speaker</string>
            </array>
            <key>Values</key>
            <array>
                <string>automatic</string>
                <string>iphone_speaker</string>
            </array>
        </dict>
        <dict>
            <key>Type</key>
            <string>PSGroupSpecifier</string>
            <key>Title</key>
            <string>Instruction voice</string>
            <key>FooterText</key>
            <string>The optional enhanced voice pack runs entirely on this iPhone. English and Spanish are available offline after installation.</string>
        </dict>
        <dict>
            <key>Type</key>
            <string>PSMultiValueSpecifier</string>
            <key>Title</key>
            <string>Instruction language</string>
            <key>Key</key>
            <string>clawpilot_instruction_language</string>
            <key>DefaultValue</key>
            <string>english</string>
            <key>Titles</key>
            <array>
                <string>English</string>
                <string>Spanish</string>
            </array>
            <key>Values</key>
            <array>
                <string>english</string>
                <string>spanish</string>
            </array>
        </dict>
    </array>
    <key>StringsTable</key>
    <string>Root</string>
