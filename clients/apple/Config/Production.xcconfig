#include "Defaults.xcconfig"
#include? "Local.xcconfig"

CLAWPILOT_ENVIRONMENT = production
CLAWPILOT_DISPLAY_NAME = ClawPilot
CLAWPILOT_SERVER_ORIGIN = https:/$()/aiapp.eigenracing.com
CLAWPILOT_PHONE_BUNDLE_IDENTIFIER = com.eigenracing.ios.picking
CLAWPILOT_WATCH_BUNDLE_IDENTIFIER = com.eigenracing.ios.picking.watch
CLAWPILOT_ASSOCIATED_DOMAIN = aiapp.eigenracing.com
CLAWPILOT_META_URL_SCHEME = clawpilot-meta
CLAWPILOT_META_APP_LINK_SCHEME = clawpilot-meta:/$()/
CLAWPILOT_META_APP_ID = $(CLAWPILOT_META_PRODUCTION_APP_ID)
CLAWPILOT_META_CLIENT_TOKEN = $(CLAWPILOT_META_PRODUCTION_CLIENT_TOKEN)
CLAWPILOT_GOOGLE_IOS_CLIENT_ID = $(CLAWPILOT_GOOGLE_PRODUCTION_IOS_CLIENT_ID)
CLAWPILOT_GOOGLE_SERVER_CLIENT_ID = $(CLAWPILOT_GOOGLE_SERVER_CLIENT_ID_SHARED)
CLAWPILOT_GOOGLE_REVERSED_CLIENT_ID = $(CLAWPILOT_GOOGLE_PRODUCTION_REVERSED_CLIENT_ID)
