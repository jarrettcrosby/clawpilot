{
  "name": "clawpilot",
  "private": true,
  "version": "0.1.0",
  "description": "ClawPilot command center web app and local operating surface.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm --prefix app_src run dev -- --hostname 0.0.0.0 --port ${PORT:-4002}",
    "start": "npm --prefix app_src run start -- --hostname 0.0.0.0 --port ${PORT:-4002}",
    "start:railway": "bash scripts/start-railway.sh",
    "lint": "npm --prefix app_src run lint",
    "build": "npm --prefix app_src run build",
    "test": "npm run test:threads && npm run test:persistence-contracts && npm run test:crm-card-boundaries && npm run test:dashboard-workspace-preferences && npm run test:suitecrm-interactions && npm run test:auth && npm run test:auth-sessions && npm run test:audit && npm run test:agent-auth && npm run test:releases && npm run test:railway-backups && npm run verify:docs",
    "test:threads": "npm --prefix app_src run test:threads",
    "test:persistence-contracts": "node scripts/test-postgres-adapter-contracts.mjs",
    "test:crm-card-boundaries": "node scripts/test-crm-card-boundaries.mjs",
    "test:dashboard-workspace-preferences": "node scripts/test-dashboard-workspace-preferences.mjs",
    "test:suitecrm-interactions": "node scripts/test-suitecrm-interaction-ingestion.mjs",
    "test:auth": "node scripts/test-auth-magic-code.mjs",
    "test:auth-sessions": "node scripts/test-browser-session-security.mjs",
    "test:audit": "node scripts/test-audit-activity.mjs",
    "test:agent-auth": "node scripts/test-chatgpt-agent-auth.mjs",
    "test:releases": "node scripts/test-release-contract.mjs",
    "test:railway-backups": "node scripts/railway-backup-audit.test.mjs",
    "verify:docs": "node scripts/verify-doc-catalog.mjs",
    "check:nightly": "npm --prefix app_src run check:nightly",
    "verify:dev": "bash scripts/dev-verify.sh",
    "verify:regression": "bash scripts/regression-all.sh",
    "verify:predeploy": "npm run verify:docs && node scripts/verify-predeploy.mjs",
    "verify:deployed": "node scripts/smoke-deployed-runtime.mjs",
    "verify:tenancy-data": "node scripts/verify-tenancy-provisioning.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:inspect": "node scripts/db-inspect-persistence.mjs",
    "db:import:tasks": "node scripts/db-import-tasks.mjs",
    "db:import:threads": "node scripts/db-import-threads.mjs",
    "crm:backfill-suitecrm": "node scripts/backfill-suitecrm-global-ids.mjs",
    "crm:backfill-suitecrm-interaction-contacts": "node scripts/backfill-suitecrm-interaction-contacts.mjs",
    "crm:delete-unresolved-interactions": "node scripts/delete-unresolved-crm-interactions.mjs",
    "users:reconcile-nick-access": "node scripts/reconcile-nick-access.mjs",
    "release:record": "node scripts/record-release.mjs",
    "mail:verify": "node scripts/verify-mail-sender.mjs",
    "check": "npm run lint && npm run build && npm run test && npm run verify:predeploy"
  }
}
