# ClawPilot local development example.
# Copy to .env.local or export values in your shell as needed.

# Runtime identity
PORT=4002
RUNTIME_LANE=dev
RUNTIME_PORT=4002
CLAWPILOT_REPO_ROOT=/Users/agentsuburbiasandwich/Desktop/clawpilot

# Auth
APP_AUTH_REQUIRED=0
# APP_LOGIN_EMAIL=operator@example.com
# APP_LOGIN_PASSWORD=replace-with-at-least-16-characters
# APP_SESSION_SECRET=replace-with-at-least-32-random-characters
# Platform-owned Google Web OAuth client. ClawPilot intentionally returns this
# same public client ID to browser GIS and uses it as the server-side ID-token
# audience for browser and native sign-in. Add each hosted ClawPilot origin to
# that client's authorized JavaScript origins before enabling an organization.
# GOOGLE_SSO_SERVER_CLIENT_ID=replace-with-web-client-id.apps.googleusercontent.com

# Dev lane file-backed state
CLAWPILOT_STORAGE=file
CLAWPILOT_DB_FALLBACK_TO_FILE=true
CLAWPILOT_EXECUTION_ENABLED=1
# Developer-only unsigned Print Agent preview. Leave disabled for every
# operator/customer build until a Developer ID signed and Apple-notarized
# native macOS application is published.
# NEXT_PUBLIC_ENABLE_DEVELOPER_PRINT_AGENT_PREVIEW=false
# Hosted agent execution uses each ClawPilot user's ChatGPT/Codex authorization.
# Local development can still select openai or openclaw explicitly.
CLAWPILOT_AGENT_PROVIDER=auto
# AGENT_CREDENTIAL_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
# Hosted dev and production use the same restricted credential database so one
# user's Codex refresh-token rotation cannot invalidate the other environment.
# AGENT_CREDENTIAL_DATABASE_URL=postgresql://credential-user:password@host:port/database?sslmode=require
# OPENAI_CODEX_AGENT_MODEL=gpt-5.4
# Allow the isolated jarrett-career-agents service identity to use the owner's
# existing ClawPilot ChatGPT/Codex authorization for bounded Career Desk runs.
# Add that dedicated source and secret to SHORTLINK_SERVICE_CLIENTS_JSON. This
# path never reads OPENAI_API_KEY.
# CAREER_SITE_AGENTS_ENABLED=1
# Interactive LinkedIn reads use a dedicated browser worker. The career site
# starts and polls durable runs; passwords and MFA values are entered only into
# LinkedIn's live browser and are never accepted by ClawPilot APIs. Keep the
# bearer token, HMAC secret, session encryption keys, and fingerprint key
# mutually distinct and server-only. Key-ring values are base64-encoded 32-byte
# random keys; environments sharing one database must share the same ring.
# CAREER_SITE_LINKEDIN_ENABLED=0
# CAREER_LINKEDIN_BROWSER_PUBLIC_URL=https://linkedin-browser.example.com
# CAREER_LINKEDIN_BROWSER_WORKER_TOKEN=replace-with-a-distinct-32-plus-character-token
# CAREER_LINKEDIN_BROWSER_WORKER_HMAC_SECRET=replace-with-a-distinct-32-plus-character-secret
# CAREER_LINKEDIN_SESSION_ACTIVE_KEY_ID=linkedin-session-v1
# CAREER_LINKEDIN_SESSION_ENCRYPTION_KEYS={"linkedin-session-v1":"base64-encoded-32-byte-key"}
# CAREER_LINKEDIN_SESSION_FINGERPRINT_KEY=base64-encoded-distinct-32-byte-key
# OPENAI_API_KEY=replace-with-a-server-api-key
# OPENAI_AGENT_MODEL=gpt-5-mini
# Repository code execution is intentionally separate from per-user ChatGPT
# authorization. It dispatches a fixed, patch-only GitHub Actions workflow
# through a narrowly scoped GitHub App and reports signed evidence back here.
# CLAWPILOT_REPOSITORY_RUNNER_ENABLED=0
# CLAWPILOT_GITHUB_APP_ID=123456
# CLAWPILOT_GITHUB_APP_BOT_USER=clawpilot-repository-runner
# CLAWPILOT_GITHUB_APP_PRIVATE_KEY_BASE64=base64-encoded-github-app-private-key
# CLAWPILOT_GITHUB_INSTALLATION_ID=12345678
# CLAWPILOT_GITHUB_REPOSITORY_ID=123456789
# CLAWPILOT_GITHUB_REPOSITORY=jarrettcrosby/clawpilot
# CLAWPILOT_GITHUB_BASE_BRANCH=dev
# CLAWPILOT_GITHUB_WORKFLOW_FILE=clawpilot-repository-runner.yml
# CLAWPILOT_REPOSITORY_RUNNER_REPORT_SECRET=replace-with-at-least-32-random-characters
# REPOSITORY_RUNNER_POLL_MS=5000
# Customer Print Agent downloads use the same server-owned GitHub App
# installation with contents-read only. Every value below is immutable release
# evidence; keep the seam disabled until the signed assets and index are final.
# CLAWPILOT_PRINT_AGENT_RELEASE_ENABLED=0
# CLAWPILOT_PRINT_AGENT_RELEASE_VERSION=0.1.0
# CLAWPILOT_PRINT_AGENT_RELEASE_TAG=print-gateway-v0.1.0
# CLAWPILOT_PRINT_AGENT_RELEASE_SOURCE_COMMIT=replace-with-the-exact-40-character-main-commit
# CLAWPILOT_PRINT_AGENT_RELEASE_INDEX_SHA256=replace-with-the-exact-64-character-release-index-sha256
# CLAWPILOT_PRINT_AGENT_RELEASE_PRERELEASE=0
# GitHub Actions separately requires OPENAI_API_KEY and the same
# CLAWPILOT_REPOSITORY_RUNNER_REPORT_SECRET as repository secrets.
# External document embeddings are opt-in and use a separate server credential.
# DOCUMENT_EMBEDDINGS_PROVIDER=local
# OPENAI_EMBEDDING_API_KEY=replace-with-a-dedicated-embedding-key
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
TASKS_PATH=/Users/agentsuburbiasandwich/Desktop/clawpilot/data-dev/tasks.json
PIPELINE_NORMALIZED_PATH=/Users/agentsuburbiasandwich/Desktop/clawpilot/data-dev/pipeline/normalized/current.json
PIPELINE_LOG_PATH=/Users/agentsuburbiasandwich/Desktop/clawpilot/data-dev/logs/pipeline-events.jsonl
PIPELINE_DROPDOWN_CACHE_PATH=/Users/agentsuburbiasandwich/Desktop/clawpilot/data-dev/pipeline/dropdowns/catalog.json
AGENT_THREADS_PATH=/Users/agentsuburbiasandwich/Desktop/clawpilot/data-dev/agents/threads.json
AGENT_ASSIGNMENTS_PATH=/Users/agentsuburbiasandwich/Desktop/clawpilot/data-dev/agents/assignments.json

# Railway Postgres. Leave unset for file-backed local dev.
# Set CLAWPILOT_STORAGE=postgres with DATABASE_URL after migrations pass.
# DATABASE_URL=postgresql://user:password@host:port/database
# PGSSLMODE=require
# PIPELINE_OUTBOX_WORKER_SECRET=replace-with-a-long-random-secret
# Enables the full interactive commerce intake only in development/local/
# preview. In production the same flag enables only read/reconciliation workers,
# and those workers accept active verified production accounts exclusively.
# CLAWPILOT_COMMERCE_INTAKE_ENABLED=1
# COMMERCE_CATALOG_SYNC_POLL_MS=10000
# COMMERCE_ORDER_RECONCILIATION_POLL_MS=60000
# SHOPIFY_INVENTORY_REFRESH_POLL_MS=10000
# COMMERCE_PRODUCT_IMAGE_IMPORT_POLL_MS=15000
# Hosted canonical-order revision evidence requires a dedicated stable
# fingerprint key plus a versioned AES-GCM key ring. Use generated server-only
# values; the active ID must be a key in the JSON object. Environments sharing
# one database must share this exact evidence-key configuration.
# INTEGRATION_EVIDENCE_FINGERPRINT_KEY=replace-with-at-least-32-random-bytes
# INTEGRATION_EVIDENCE_ACTIVE_KEY_ID=revision-v1
# INTEGRATION_EVIDENCE_ENCRYPTION_KEYS={"revision-v1":"replace-with-at-least-32-random-bytes"}
# Safe local application of a fresh, wholly unstarted provider revision remains
# independently default-off. Enable only after migrations and acceptance gates.
# CLAWPILOT_COMMERCE_ORDER_REVISION_APPLY_ENABLED=1
# Shopify order management is default-off. Development/local writes require
# the development flag and exact sandbox commerce-account Global IDs below.
# The server rechecks the runtime and allowlist before every provider attempt;
# Vercel is never an accepted write runtime. Line changes and the separate
# fulfillment-reversal fixture still require a Shopify test order.
# CLAWPILOT_SHOPIFY_ORDER_TEST_WRITES_ENABLED=1
# CLAWPILOT_SHOPIFY_ORDER_TEST_WRITE_ACCOUNT_IDS=gia0000001
# Production order cancellation has a separate default-off gate accepted only
# by the exact Railway production project/service/environment and exact
# verified production account allowlist. Even with both values set, every
# other production order-management write remains blocked. Do not set these
# before a separately approved live-store validation and rollback plan.
# CLAWPILOT_SHOPIFY_ORDER_PRODUCTION_WRITES_ENABLED=1
# CLAWPILOT_SHOPIFY_ORDER_PRODUCTION_WRITE_ACCOUNT_IDS=gia0000001
# Hidden route-and-CLI-only reversal fixture. This additional gate is accepted
# only by the exact trusted Railway development project, environment, database,
# fixed account, and live Partner development store. Never set it in local,
# preview, Vercel, or production runtimes.
# CLAWPILOT_SHOPIFY_REVERSAL_FIXTURE_ENABLED=1
# Required before Shopify product-image publishing can issue a short-lived
# provider delivery URL. Keep this server-only and use at least 32 random bytes.
# SHOPIFY_PRODUCT_MEDIA_SIGNING_SECRET=replace-with-at-least-32-random-characters
# Optional exact public HTTPS origin for Shopify to retrieve immutable image
# bytes. When unset, ClawPilot uses the current request origin. Active mode
# rejects localhost, private hostnames, and IP literals.
# SHOPIFY_PRODUCT_MEDIA_PUBLIC_ORIGIN=https://dev.example.com
# Hosted Shadow checkout proofs fail closed unless the authenticated Shopify
# customer has a simulated Checkout audience policy stored in ClawPilot and
# every shippable variant ID matches this server-only test-data allowlist.
# Never use callback contact text as an authorization boundary.
# SHOPIFY_CHECKOUT_SHADOW_ALLOWED_VARIANT_IDS=987654321
# SHORTLINK_PUBLIC_ORIGIN=https://eigenracing.com
# Use one backend-only client entry per trusted application. Do not expose these
# credentials to browser bundles.
# SHORTLINK_SERVICE_CLIENTS_JSON=[{"sourceApp":"eigenracing","secret":"replace-with-32-or-more-random-characters"},{"sourceApp":"jarrett-career-site","secret":"use-a-unique-server-only-random-secret","ownerDomain":"suburbiasandwichco.com","ownerEmail":"jarrett@suburbiasandwichco.com","organizationId":"405bb919-0364-4a88-8a62-b4c9da42cd8f"}]
# Career-site form intake remains off until the private Google Sheet is created,
# its exact tab uses the documented columns, and the configured ClawPilot Google
# service account has editor access. The website calls ClawPilot server-to-server
# with the jarrett-career-site short-link client; never expose that secret or a
# Google service-account credential to browser code.
# CAREER_SITE_SUBMISSIONS_ENABLED=1
# CAREER_SITE_SUBMISSIONS_OWNER_EMAIL=jarrett@suburbiasandwichco.com
# CAREER_SITE_SUBMISSIONS_ORGANIZATION_ID=405bb919-0364-4a88-8a62-b4c9da42cd8f
# CAREER_SITE_SUBMISSIONS_SHEET_ID=replace-with-private-google-sheet-id
# CAREER_SITE_SUBMISSIONS_SHEET_TAB=Submissions
# CAREER_SITE_SUBMISSIONS_SHEET_HEADER_ROW=4
# CAREER_SITE_SUBMISSIONS_POLL_MS=10000
# Career-site transactional email reuses the existing Maton Google Mail
# connection. These values are intentionally separate from CLAWPILOT_MAIL_FROM
# so platform mail keeps its existing sender identity unchanged.
# CAREER_SITE_MAIL_FROM=info@suburbiasandwichco.com
# CAREER_SITE_MAIL_FROM_NAME=Jarrett Crosby
# CAREER_SITE_MAIL_REPLY_TO=JarrettCrosby@gmail.com
# CAREER_SITE_MAIL_APPROVAL_TO=JarrettCrosby@gmail.com
# Exact production and currently approved preview origins only; never use wildcards.
# CAREER_SITE_MAIL_APPROVAL_ORIGINS_JSON=["https://jarrett.suburbiasandwichco.com","https://jarrett-suburbia-oe7m9xkz6-jarrettcrosbys-projects.vercel.app"]
# DOCUMENT_EMBEDDING_POLL_MS=15000
# AI_RADAR_POLL_MS=3600000
# AI_RADAR_ENABLED=true
# AI_RADAR_FEEDS_JSON=[{"key":"vendor-news","name":"Vendor News","url":"https://example.com/rss.xml","category":"AI","tags":["ai"]}]
# MATON_API_KEY=replace-with-the-Maton-API-key
# MATON_API_KEY_FILE=/absolute/path/to/maton_api_key.txt
# MATON_GMAIL_CONNECTION_ID=replace-with-an-active-google-mail-connection-id
# Optional dedicated Google Mail connection for authentication codes. Set both
# values or neither. The connection and resolved Gmail account must differ from
# the platform connection/account. The visible sender may intentionally match
# CLAWPILOT_MAIL_FROM, but it must be an accepted send-as identity on the
# dedicated account. When omitted, magic codes continue to use the platform
# pair. With a dedicated pair, a code addressed to that account's authenticated
# primary mailbox is routed once through the platform account; all other codes
# use the dedicated account, with no failure fallback. Invitations and
# operational mail always remain on the platform.
# MATON_AUTH_GMAIL_CONNECTION_ID=replace-with-an-active-personal-google-mail-connection-id
# CLAWPILOT_AUTH_MAIL_FROM=stewards@eigenracing.com
# Optional additional exact ClawPilot auth sender addresses for CRM ingestion
# exclusion (other environments or historical senders). Comma-separated; case
# and surrounding whitespace are normalized, invalid entries are ignored.
# This does not authorize sending email or exclude all mail from these senders:
# the exact sign-in subject and auth-purpose header/full legacy template must
# also match. Gmail messages are never modified by this exclusion.
# CLAWPILOT_AUTH_MAIL_ADDITIONAL_SENDERS=auth-dev@example.com,legacy-auth@example.com
# Optional: operator-verified aliases belonging to this exact sending mailbox.
# Only newly sent sign-in codes for these exact recipients receive INBOX/UNREAD.
# This does not change sender identity or relabel any existing email.
# CLAWPILOT_AUTH_SELF_DELIVERY={"connectionId":"exact-google-mail-connection-id","mailboxEmail":"operator@example.com","recipientEmails":["operator@example.com","old-alias@example.com"]}

# QuickBooks provider writes remain off unless both flags are explicitly set and
# the organization connection has the matching verified write_mode in Postgres.
# QUICKBOOKS_WRITES_ENABLED=1
# QUICKBOOKS_WRITE_MODE=sandbox
# CLAWPILOT_MAIL_FROM=stewards@eigenracing.com
# CLAWPILOT_PUBLIC_URL=http://localhost:4002
# Development-only automatic Faire promotion remains off unless both values
# are present. Use the exact comma-separated Faire integration-account Global
# ID cohort and a canonical UTC rollout boundary including milliseconds. Orders
# provider-created before that boundary remain excluded when rediscovered.
# CLAWPILOT_FAIRE_ORDER_AUTO_PROMOTION_ACCOUNT_GLOBAL_IDS=gia0000001
# CLAWPILOT_FAIRE_ORDER_AUTO_PROMOTION_NOT_BEFORE=2026-08-04T12:00:00.000Z
# PIPELINE_SHEET_ID=replace-with-the-environment-specific-Sheet-id

# SuiteCRM. Keep the base URL on the private Railway network; only the exact
# pathless HTTPS public origin is used for owner/admin browser punchout.
# CRM_ENABLED=0
# SUITECRM_BASE_URL=http://suitecrm.railway.internal:8080
# SUITECRM_PUBLIC_URL=https://crm.example.com
# SUITECRM_CLIENT_ID=replace-with-a-UUID-client-id
# SUITECRM_CLIENT_SECRET=replace-with-at-least-32-random-characters
# Native SuiteCRM Product-image projection is opt-in. When omitted, the
# existing legacy Product image URL projection remains active by itself.
# SUITECRM_NATIVE_PRODUCT_IMAGE_PROJECTION_ENABLED=1
# The opt-in native-media path requires a dedicated non-admin browser-session
# user. Put the same complete pair on the SuiteCRM service so container boot can
# create and verify its exact ACL. Never reuse administrator or OAuth credentials.
# SUITECRM_MEDIA_USERNAME=clawpilot-media
# SUITECRM_MEDIA_PASSWORD=replace-with-a-dedicated-random-password
# Reverse SuiteCRM Product-image ingestion is separately opt-in and read-only.
# Use a second dedicated SuiteCRM user and OAuth client; do not reuse the
# administrator, forward native-media, or general V8 credentials. Put the same
# four values on the SuiteCRM service before enabling reverse ingestion here.
# SUITECRM_PRODUCT_IMAGE_REVERSE_INGESTION_ENABLED=1
# SUITECRM_PRODUCT_IMAGE_READ_CLIENT_ID=replace-with-a-dedicated-read-client-id
# SUITECRM_PRODUCT_IMAGE_READ_CLIENT_SECRET=replace-with-a-dedicated-read-client-secret
# SUITECRM_PRODUCT_IMAGE_READ_USERNAME=clawpilot-image-reader
# SUITECRM_PRODUCT_IMAGE_READ_PASSWORD=replace-with-a-dedicated-read-password
# The attestation values bind the reviewed ACL to the exact read user/client.
# SUITECRM_PRODUCT_IMAGE_READ_ACL_ATTESTED=1
# SUITECRM_PRODUCT_IMAGE_READ_ACL_ATTESTATION_VERSION=suitecrm-product-image-read-acl-v2
# SUITECRM_PRODUCT_IMAGE_READ_ACL_ATTESTED_USERNAME=clawpilot-image-reader
# SUITECRM_PRODUCT_IMAGE_READ_ACL_ATTESTED_CLIENT_ID=replace-with-the-same-dedicated-read-client-id
# SUITECRM_PRODUCT_IMAGE_READ_ACL_ATTESTED_OAUTH_USERNAME=clawpilot-image-reader
# CLAWPILOT_ROOT_ORGANIZATION_NAME=Your Company

# Governance toggles
ENABLE_AUTOMATION_TASK_CREATE=false
ENABLE_SUGGESTION_TASK_CREATE=false
