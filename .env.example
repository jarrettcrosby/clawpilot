# ClawPilot local development example.
# Copy to .env.local or export values in your shell as needed.

# Runtime identity
PORT=4002
RUNTIME_LANE=dev
RUNTIME_PORT=4002
CLAWPILOT_REPO_ROOT=/Users/agentsuburbiasandwich/Desktop/clawd-app-dev

# Auth
APP_AUTH_REQUIRED=0

# Dev lane file-backed state
CLAWPILOT_STORAGE=file
TASKS_PATH=/Users/agentsuburbiasandwich/Desktop/clawd-app-dev/data-dev/tasks.json
PIPELINE_NORMALIZED_PATH=/Users/agentsuburbiasandwich/Desktop/clawd-app-dev/data-dev/pipeline/normalized/current.json
PIPELINE_LOG_PATH=/Users/agentsuburbiasandwich/Desktop/clawd-app-dev/data-dev/logs/pipeline-events.jsonl
AGENT_THREADS_PATH=/Users/agentsuburbiasandwich/Desktop/clawd-app-dev/data-dev/agents/threads.json
AGENT_ASSIGNMENTS_PATH=/Users/agentsuburbiasandwich/Desktop/clawd-app-dev/data-dev/agents/assignments.json

# Railway Postgres. Leave unset for file-backed local dev.
# Set CLAWPILOT_STORAGE=postgres with DATABASE_URL after migrations pass.
# DATABASE_URL=postgresql://user:password@host:port/database
# PGSSLMODE=require

# Governance toggles
ENABLE_AUTOMATION_TASK_CREATE=false
ENABLE_SUGGESTION_TASK_CREATE=false
